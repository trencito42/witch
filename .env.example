# Application
NODE_ENV=production
PORT=3003
NEXT_PUBLIC_APP_URL=https://witch.pw
APP_URL=https://witch.pw
BETTER_AUTH_URL=https://witch.pw
AUTH_TRUSTED_ORIGINS=https://witch.pw,https://www.witch.pw

# MySQL (required)
# mysql://user:password@127.0.0.1:3306/witch
DATABASE_URL=mysql://witch:changeme@127.0.0.1:3306/witch

# Auth (required in production). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: enable the local fixture target used by tests
FIXTURE_ENABLED=true
FIXTURE_PORT=3456

# Email — leave unset to disable outbound email (auth still works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Witch <noreply@witch.pw>
# Optional Resend alternative. If RESEND_API_KEY is set it is preferred over SMTP.
RESEND_API_KEY=

# AI analysis — leave unset to skip AI (deterministic monitoring still works)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_MAX_INPUT_CHARS=12000

# Stripe — leave unset to disable checkout (Free plan still works)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FREELANCER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PRO=

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage

# Playwright
PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_CHROMIUM_PATH=

# Logging
LOG_LEVEL=info

# Monitoring defaults (seconds)
HTTP_CONFIRMATION_FAILURES=2
HTTP_RECOVERY_SUCCESSES=2
CHECK_CONFIRMATION_DELAY_SECONDS=45
BROWSER_CHECK_TIMEOUT_MS=45000
HTTP_CHECK_TIMEOUT_MS=15000
MAX_REDIRECTS=5
