{
  "name": "witch",
  "version": "1.0.0",
  "private": true,
  "description": "Witch — website monitoring beyond uptime",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx --require ./worker/register-server-only.cjs worker/index.ts",
    "scheduler": "tsx --require ./worker/register-server-only.cjs worker/scheduler.ts",
    "worker:all": "tsx --require ./worker/register-server-only.cjs worker/combined.ts",
    "fixture": "tsx scripts/fixture-server.ts",
    "promote-admin": "tsx scripts/promote-admin.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.47.0",
    "mysql2": "^3.24.4",
    "next": "15.5.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "openai": "^7.18.0",
    "pino": "^10.3.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
