[Unit]
Description=Witch scheduler
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/home/witch/htdocs/witch.pw
EnvironmentFile=/home/witch/htdocs/witch.pw/.env
ExecStart=/usr/bin/npx tsx worker/scheduler.ts
Restart=on-failure
RestartSec=5
User=witch
Group=witch

[Install]
WantedBy=multi-user.target
